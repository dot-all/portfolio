---
// src/pages/index.astro
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/outfit/500.css';

import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter500 from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import outfit500 from '@fontsource/outfit/files/outfit-latin-500-normal.woff2?url';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href={inter500} as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href={inter600} as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href={outfit500} as="font" type="font/woff2" crossorigin="anonymous">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allan — Ingeniero de Software</title>
    <meta name="description" content="Allan es un Ingeniero de Software enfocado en diseño y construcción de sistemas escalables. Residente en Viña del Mar, Chile.">
    <meta name="theme-color" content="#fcfcfc">
    <meta property="og:title" content="Allan — Ingeniero de Software">
    <meta property="og:description" content="Diseño y construcción de sistemas escalables.">
    <meta property="og:image" content="/og.png">
    <meta property="og:type" content="website">
    <link rel="icon" href="/favicon.ico">

    <style>
        :root {
            --ey-bg: #fbfbfd;
            --ey-heading: #1d1d1f;
            --ey-text: #4a5568;
            --highlight-color: rgba(251, 146, 60, 0.4);
            --highlight-hover: rgba(251, 146, 60, 0.75);
            --selection-bg: #fed7aa;
            --selection-text: #9a3412;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: var(--ey-bg);
            color: var(--ey-text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        ::selection {
            background-color: var(--selection-bg);
            color: var(--selection-text);
        }

        .skip-link {
            position: absolute;
            top: -100%;
            left: 1rem;
            padding: 0.5rem 1rem;
            background: var(--selection-bg);
            color: var(--selection-text);
            border-radius: 0 0 4px 4px;
            z-index: 100;
            font-size: 14px;
            text-decoration: none;
        }
        .skip-link:focus { top: 0; }

        .hero-container {
            max-width: 640px;
            width: 100%;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        .hero-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 3rem;
        }

        .hero-title {
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "SF Pro", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-weight: 500;
            font-size: 2.25rem;
            line-height: 1.2;
            color: var(--ey-heading);
            letter-spacing: -0.03em;
        }

        @media (min-width: 640px) {
            .hero-title { font-size: 44px; }
        }

        .lang-selector {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 13px;
        }
        .lang-btn {
            background: none;
            border: none;
            padding: 0;
            font-family: inherit;
            font-size: inherit;
            font-weight: 500;
            color: #636366;
            cursor: pointer;
            transition: color 0.2s ease;
        }
        .lang-btn:hover {
            color: var(--ey-heading);
        }
        .lang-btn:focus-visible {
            outline: 2px solid var(--highlight-hover);
            outline-offset: 2px;
        }
        .lang-btn.active {
            color: var(--ey-heading);
            font-weight: 600;
        }
        .lang-separator {
            color: #d2d2d7;
            user-select: none;
        }

        .content-wrapper {
            display: grid;
        }

        .hero-content {
            font-size: 15px;
            line-height: 1.625;
            grid-area: 1 / 1;
            transition: opacity 0.3s ease;
        }
        @media (min-width: 640px) {
            .hero-content { font-size: 16px; }
        }

        .hero-content p { margin-bottom: 1.75rem; }
        .hero-content p:last-child { margin-bottom: 0; }

        @keyframes marker-draw {
            0% { transform: var(--marker-transform) scaleX(0); }
            100% { transform: var(--marker-transform) scaleX(1); }
        }

        .highlight-link {
            position: relative;
            text-decoration: none;
            color: #1d1d1f;
            font-weight: 600;
            white-space: nowrap;
            z-index: 1;
            padding: 0 4px;
            margin: 0 2px;
            cursor: pointer;
            transition: transform 0.15s ease;
        }
        .highlight-link:hover {
            transform: translateY(-1px);
        }

        .highlight-link::after,
        .highlight-link::before {
            content: '';
            position: absolute;
            z-index: -1;
            mix-blend-mode: multiply;
            background-color: var(--highlight-color);
            transition: background-color 0.2s ease;
            transform-origin: left;
            animation: marker-draw 0.4s cubic-bezier(0.22, 1, 0.36, 1) backwards;
        }

        /* Trazo principal */
        .highlight-link::after {
            --marker-transform: rotate(-1.5deg) skewX(-10deg);
            top: 38%; 
            bottom: -5%;
            left: -8px;
            right: -12px;
            transform: rotate(-1.5deg) skewX(-10deg);
            border-radius: 4px 15px 4px 15px / 15px 4px 15px 4px;
            animation-delay: var(--marker-delay, 0.6s);
        }

        /* Segundo pase */
        .highlight-link::before {
            --marker-transform: rotate(2deg) skewX(5deg);
            top: 48%;
            bottom: 2%;
            left: 2px;
            right: -6px;
            opacity: 0.8;
            transform: rotate(2deg) skewX(5deg);
            border-radius: 10px;
            animation-delay: calc(var(--marker-delay, 0.6s) + 0.12s);
        }

        /* Variación 2 */
        .highlight-link:nth-of-type(2n)::after {
            --marker-transform: rotate(1deg) skewX(4deg);
            transform: rotate(1deg) skewX(4deg);
            border-radius: 10px 5px 15px 5px / 5px 15px 5px 10px;
            top: 42%;
            left: -5px;
            right: -10px;
        }
        .highlight-link:nth-of-type(2n)::before {
            --marker-transform: rotate(-1.5deg) skewX(-6deg);
            transform: rotate(-1.5deg) skewX(-6deg);
            left: 8px;
            right: -4px;
        }

        /* Variación 3 */
        p:nth-of-type(odd) .highlight-link:nth-of-type(1)::after {
            --marker-transform: rotate(-0.5deg) skewX(-8deg);
            transform: rotate(-0.5deg) skewX(-8deg);
            border-radius: 5px 10px 3px 12px / 10px 5px 12px 3px;
            top: 36%;
            bottom: -8%;
            left: -12px;
            right: -6px;
        }
        p:nth-of-type(odd) .highlight-link:nth-of-type(1)::before {
            --marker-transform: rotate(2.5deg) skewX(2deg);
            transform: rotate(2.5deg) skewX(2deg);
            left: -2px;
            right: 12px;
            top: 50%;
        }

        .highlight-link:hover::after,
        .highlight-link:hover::before,
        .highlight-link:focus-visible::after,
        .highlight-link:focus-visible::before {
            background-color: var(--highlight-hover);
        }

        .highlight-link:focus-visible {
            outline: none;
        }

        html[lang="es"] [lang="en"],
        html[lang="en"] [lang="es"] { 
            visibility: hidden !important; 
            opacity: 0 !important;
            pointer-events: none !important;
        }

        .toast {
            position: fixed;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: rgba(29, 29, 31, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: #fbfbfd;
            padding: 0.75rem 1.5rem;
            border-radius: 9999px;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15), 0 0 1px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
            opacity: 0;
            z-index: 1000;
            pointer-events: none;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
    </style>
    <script is:inline>
        const saved = localStorage.getItem('lang');
        const browser = navigator.language?.startsWith('en') ? 'en' : 'es';
        document.documentElement.lang = saved || browser;
    </script>
</head>
<body>

    <a href="#main-content" class="skip-link" data-skip-es="Saltar al contenido" data-skip-en="Skip to content" aria-label="Saltar al contenido">Saltar al contenido</a>

    <main id="main-content" class="hero-container">

        <header class="hero-header">
            <h1 class="hero-title">Allan</h1>
            <div class="lang-selector">
                <button class="lang-btn" id="lang-btn-es" type="button" aria-label="Cambiar a Español">ES</button>
                <span class="lang-separator" aria-hidden="true">/</span>
                <button class="lang-btn" id="lang-btn-en" type="button" aria-label="Switch to English">EN</button>
            </div>
        </header>

        <div class="content-wrapper">
            <div id="content-es" lang="es" class="hero-content">
            <p>
                Soy ingeniero de software enfocado en el diseño y construcción de sistemas escalables. Actualmente resido en Viña del Mar, Chile, participando en la creación de productos tecnológicos de alto impacto.
            </p>
            <p>
                A lo largo de mi trayectoria, he evolucionado desde la implementación pura hasta la toma de decisiones arquitectónicas críticas. Mi filosofía de ingeniería es simple: la tecnología debe servir al producto, no al revés. Priorizo la mantenibilidad, una baja carga cognitiva en el código y arquitecturas resilientes por encima de la adopción de herramientas de moda.
            </p>
            <p>
                En lugar de atarme a un lenguaje específico, me adapto al ecosistema que mejor resuelva el problema actual. Gran parte de mi trabajo reciente involucra sistemas en la nube y arquitecturas distribuidas, construyendo puentes sólidos entre lógicas de backend complejas (utilizando entornos tipados como C# o ecosistemas dinámicos en Python) y experiencias de usuario de alta fidelidad.
            </p>
            <p>
                Puedes explorar mis repositorios y experimentos técnicos en mi perfil de <a href="https://github.com/dot-all" target="_blank" rel="noopener noreferrer" class="highlight-link" style="--marker-delay: 0.8s" aria-label="Perfil de GitHub de Allan">GitHub</a>, o revisar mi trayectoria en detalle descargando mi <a href="/cv/es/CV_ALLAN_QUIROZ.pdf" target="_blank" class="highlight-link" style="--marker-delay: 1.1s" aria-label="CV — Descargar currículum vitae de Allan">CV</a>. Si alguna de mis soluciones open-source te ha sido de utilidad, considera dejar una estrella.
            </p>
            <p>
                Si deseas discutir sobre arquitectura de software, prácticas de ingeniería o explorar posibles colaboraciones, la vía más directa es a través de <a href="#" data-user="al.quirozsilva" data-domain="gmail.com" class="highlight-link email-copy-btn" style="--marker-delay: 1.4s" aria-label="Email — Copiar correo electrónico de Allan">Email</a> o conectando conmigo en <a href="https://www.linkedin.com/in/im-allan/" target="_blank" rel="noopener noreferrer" class="highlight-link" style="--marker-delay: 1.7s" aria-label="LinkedIn — Perfil de Allan">LinkedIn</a>.
            </p>
        </div>

        <div id="content-en" lang="en" class="hero-content">
            <p>
                I'm a Software Engineer focused on the design and construction of scalable systems. Currently based in Viña del Mar, Chile, building high-impact technology products.
            </p>
            <p>
                Throughout my career, I've evolved from pure implementation to making critical architectural decisions. My engineering philosophy is simple: technology should serve the product, not the other way around. I prioritize maintainability, low cognitive load in code, and resilient architectures over adopting trendy tools.
            </p>
            <p>
                Rather than tying myself to a specific language, I adapt to the ecosystem that best solves the problem at hand. Much of my recent work involves cloud systems and distributed architectures, building solid bridges between complex backend logic (using typed environments like C# or dynamic ecosystems in Python) and high-fidelity user experiences.
            </p>
            <p>
                You can explore my repositories and technical experiments on my <a href="https://github.com/dot-all" target="_blank" rel="noopener noreferrer" class="highlight-link" style="--marker-delay: 0.8s" aria-label="Allan's GitHub profile">GitHub</a> profile, or review my background in detail by downloading my <a href="/cv/en/CV_ALLAN_QUIROZ.pdf" target="_blank" class="highlight-link" style="--marker-delay: 1.1s" aria-label="Resume — Download Allan's resume">Resume</a>. If any of my open-source solutions have been useful to you, consider starring them.
            </p>
            <p>
                If you'd like to discuss software architecture, engineering practices, or explore potential collaborations, the most direct way is through <a href="#" data-user="al.quirozsilva" data-domain="gmail.com" class="highlight-link email-copy-btn" style="--marker-delay: 1.4s" aria-label="Email — Copy Allan's email address">Email</a> or connecting with me on <a href="https://www.linkedin.com/in/im-allan/" target="_blank" rel="noopener noreferrer" class="highlight-link" style="--marker-delay: 1.7s" aria-label="LinkedIn — Allan's profile">LinkedIn</a>.
            </p>
        </div>
        </div>

    </main>

    <script>
        const esBtn = document.getElementById('lang-btn-es');
        const enBtn = document.getElementById('lang-btn-en');
        const html = document.documentElement;
        const skip = document.querySelector('.skip-link');

        function updateUI() {
            const isEn = html.lang === 'en';
            
            esBtn.classList.toggle('active', !isEn);
            enBtn.classList.toggle('active', isEn);
            
            const skipText = isEn ? skip.getAttribute('data-skip-en') : skip.getAttribute('data-skip-es');
            skip.textContent = skipText;
            skip.setAttribute('aria-label', skipText);
            document.title = isEn ? 'Allan — Software Engineer' : 'Allan — Ingeniero de Software';
        }

        esBtn.addEventListener('click', () => {
            html.lang = 'es';
            localStorage.setItem('lang', 'es');
            updateUI();
        });

        enBtn.addEventListener('click', () => {
            html.lang = 'en';
            localStorage.setItem('lang', 'en');
            updateUI();
        });

        updateUI();

        const toast = document.getElementById('toast');
        let toastTimeout;

        function showToast(message) {
            toast.textContent = message;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }

        const emailBtns = document.querySelectorAll<HTMLElement>('.email-copy-btn');
        emailBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const email = btn.dataset.user + '@' + btn.dataset.domain;
                navigator.clipboard.writeText(email).then(() => {
                    const isEn = html.lang === 'en';
                    showToast(isEn ? 'Email copied to clipboard!' : '¡Correo copiado al portapapeles!');
                });
            });
        });
    </script>

    <div id="toast" class="toast" role="alert" aria-live="polite"></div>

</body>
</html>
